# Supabase — Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Session cookie encryption key — must be at least 32 random characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# 종주T shared admin password (plaintext here only for local seeding —
# the app stores/checks a bcrypt hash, never this value, at runtime)
ADMIN_PASSWORD=

# 국립국어원 표준국어대사전 Open API — https://stdict.korean.go.kr/openapi/openApiInfo.do
STDICT_API_KEY=
