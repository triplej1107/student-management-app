# Supabase — Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Session cookie encryption key — must be at least 32 random characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# 종주T shared admin password (plaintext here only for local seeding —
# the app stores/checks a bcrypt hash, never this value, at runtime)
ADMIN_PASSWORD=

# Anthropic API key — used server-side only (/api/feedback-generate)
# to turn a 조교's selected feedback tags into a written sentence.
ANTHROPIC_API_KEY=

# 국립국어원 표준국어대사전 Open API key — used server-side only
# (/dictionary) so it's never exposed to the client.
STDICT_API_KEY=

# Web Push VAPID key pair (클리닉 1주 밀림 자동 알림). Generate with:
# node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Shared secret Vercel Cron sends as "Authorization: Bearer <value>" when
# it calls /api/cron/clinic-backlog-push. Generate with:
# node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# 맥가이7(학원관리 프로그램) 조회용 계정 — 강의 출결 자동 연동에 쓴다.
# 원장님 본인 계정 말고, 출결현황만 볼 수 있는 직원 계정을 따로 만들어 쓸 것.
# 비어 있으면 연동 크론이 그냥 건너뛴다(에러로 쌓지 않음).
MACGAI7_ID=
MACGAI7_PASSWORD=
